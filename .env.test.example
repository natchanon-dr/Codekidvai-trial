# Integration test environment — database-backed pipeline-worker validation.
#
# Copy this file to .env.test and fill in values for your local isolated database.
# NEVER use production .env.local values here.
# .env.test is listed in .gitignore; this example file is safe to commit.
#
# ── Local Supabase (recommended) ──────────────────────────────────────────────
#
#   npm install -g supabase
#   supabase init
#   supabase start
#   supabase status        ← prints the values you need below
#
# ── Run the integration suite ─────────────────────────────────────────────────
#
#   npx dotenv -e .env.test -- npx vitest run __tests__/integration/
#
# ── Migration apply order (run once against the local DB) ────────────────────
#
#   Apply in this exact order — 022 is the Expand-Migrate-Contract constraint
#   that must come AFTER the worker is confirmed to write cancelled_at correctly:
#
#   001 → 002 → 003 → 004 → 005 → 006 → 007 → 008 → 009 → 010
#   → 011 → 012 → 013 → 014 → 015 → 016 → 017 → 018 → 019 → 020
#   → 021 → 023 → 022
#
#   Using psql:
#     DB="postgresql://postgres:postgres@localhost:54322/postgres"
#     for f in database/migrations/0{01..21}*.sql database/migrations/023*.sql database/migrations/022*.sql; do
#       psql "$DB" -f "$f"
#     done
#
#   Using supabase CLI:
#     supabase db push --local    (applies all migrations in filename order;
#                                  manually reorder 022/023 if needed)
#
# ─────────────────────────────────────────────────────────────────────────────

# Local Supabase URL (default port when using `supabase start`)
INTEGRATION_SUPABASE_URL=http://localhost:54321

# Service-role secret from `supabase status`
INTEGRATION_SERVICE_ROLE_KEY=your-local-service-role-key-here

# Anon key from `supabase status` (used for RPC security tests)
INTEGRATION_SUPABASE_ANON_KEY=your-local-anon-key-here
